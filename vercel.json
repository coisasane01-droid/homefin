{
  "rewrites": [
    {
      "source": "/api/passkey",
      "destination": "/api/family-auth?mode=passkey"
    },
    {
      "source": "/api/inventory-recognize",
      "destination": "/api/inventory?mode=recognize"
    },
    {
      "source": "/api/inventory-photo",
      "destination": "/api/inventory?mode=photo"
    },
    {
      "source": "/api/family-enrollment",
      "destination": "/api/family-auth"
    },
    {
      "source": "/api/push-subscribe",
      "destination": "/api/push?mode=subscribe"
    },
    {
      "source": "/api/push-broadcast",
      "destination": "/api/push?mode=broadcast"
    },
    {
      "source": "/api/family-attachments",
      "destination": "/api/family-files?mode=attachments"
    },
    {
      "source": "/api/family-delete",
      "destination": "/api/family-files?mode=delete"
    },
    {
      "source": "/api/family-storage-cleanup",
      "destination": "/api/family-files?mode=cleanup"
    }
  ],
  "headers": [
    {
      "source": "/",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/index.html",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/homefin",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/homefin/",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/homefin/index.html",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/admin",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/admin/",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/admin/index.html",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/sw.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, must-revalidate"
        }
      ]
    },
    {
      "source": "/admin/sw.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, must-revalidate"
        }
      ]
    },
    {
      "source": "/manifest.json",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, must-revalidate"
        }
      ]
    },
    {
      "source": "/manifest-admin.json",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, must-revalidate"
        }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ]
}
