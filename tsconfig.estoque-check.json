{
  "extends": "./tsconfig.json",
  "include": [
    "App.tsx",
    "pages/**/*.ts",
    "pages/**/*.tsx",
    "components/**/*.ts",
    "components/**/*.tsx",
    "services/**/*.ts",
    "types/**/*.ts",
