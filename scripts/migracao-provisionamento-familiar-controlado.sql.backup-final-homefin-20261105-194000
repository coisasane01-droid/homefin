-- HomeFin: provisionamento administrativo controlado de credenciais legadas.
-- Preparada para revisao e execucao manual; NAO foi executada no Supabase.
-- Requer homefin_saas e a estrutura de credenciais instalada, incluindo session_version.
-- Nenhum dado financeiro ou credencial existente e removido/alterado por esta migracao.

DO $preflight$
BEGIN
    IF pg_catalog.to_regclass('public.homefin_saas') IS NULL THEN
        RAISE EXCEPTION 'Pre-requisito ausente: public.homefin_saas.';
    END IF;
    IF pg_catalog.to_regclass('public.homefin_family_credentials') IS NULL THEN
        RAISE EXCEPTION 'Pre-requisito ausente: public.homefin_family_credentials.';
    END IF;

    IF EXISTS (
        SELECT required.table_name, required.column_name
          FROM (VALUES
              ('homefin_saas', 'id', 'text'),
              ('homefin_saas', 'data', 'jsonb'),
              ('homefin_family_credentials', 'family_id', 'text'),
              ('homefin_family_credentials', 'pin_salt', 'text'),
              ('homefin_family_credentials', 'pin_hash', 'text'),
              ('homefin_family_credentials', 'recovery_salt', 'text'),
              ('homefin_family_credentials', 'recovery_hash', 'text'),
              ('homefin_family_credentials', 'session_version', 'integer'),
              ('homefin_family_credentials', 'created_at', 'timestamp with time zone'),
              ('homefin_family_credentials', 'updated_at', 'timestamp with time zone')
          ) AS required(table_name, column_name, data_type)
          LEFT JOIN information_schema.columns AS existing
            ON existing.table_schema = 'public'
           AND existing.table_name = required.table_name
           AND existing.column_name = required.column_name
         WHERE existing.column_name IS NULL
            OR existing.data_type <> required.data_type
    ) THEN
        RAISE EXCEPTION 'Pre-requisito ausente: esquema de autenticacao familiar incompleto; aplique e valide as migracoes base primeiro.';
    END IF;
END;
$preflight$;

CREATE TABLE IF NOT EXISTS public.homefin_family_enrollment_authorizations (
    id uuid PRIMARY KEY DEFAULT pg_catalog.gen_random_uuid(),
    family_id text NOT NULL,
    authorization_hash text NOT NULL UNIQUE,
    verification_method text NOT NULL,
    verified_by text NOT NULL,
    created_at timestamptz NOT NULL DEFAULT pg_catalog.now(),
    expires_at timestamptz NOT NULL,
    consumed_at timestamptz,
    revoked_at timestamptz,
    CONSTRAINT homefin_family_enrollment_authorizations_family_format
        CHECK (family_id ~ '^[a-z0-9][a-z0-9-]{0,99}$'),
    CONSTRAINT homefin_family_enrollment_authorizations_hash_format
        CHECK (authorization_hash ~ '^[a-f0-9]{64}$'),
    CONSTRAINT homefin_family_enrollment_authorizations_verified_by_length
        CHECK (char_length(btrim(verified_by)) BETWEEN 2 AND 80),
    CONSTRAINT homefin_family_enrollment_authorizations_method
        CHECK (verification_method IN (
            'known_phone',
            'previously_verified_email',
            'in_person',
            'other_official_channel'
        ))
);

CREATE UNIQUE INDEX IF NOT EXISTS homefin_family_enrollment_one_active_idx
    ON public.homefin_family_enrollment_authorizations (family_id)
    WHERE consumed_at IS NULL AND revoked_at IS NULL;

CREATE INDEX IF NOT EXISTS homefin_family_enrollment_expiry_idx
    ON public.homefin_family_enrollment_authorizations (expires_at);

CREATE TABLE IF NOT EXISTS public.homefin_family_enrollment_attempts (
    id bigint GENERATED ALWAYS AS IDENTITY PRIMARY KEY,
    family_id text NOT NULL,
    ip_hash text NOT NULL,
    attempted_at timestamptz NOT NULL DEFAULT pg_catalog.now(),
    CONSTRAINT homefin_family_enrollment_attempts_family_format
        CHECK (family_id ~ '^[a-z0-9][a-z0-9-]{0,99}$'),
    CONSTRAINT homefin_family_enrollment_attempts_ip_hash_format
        CHECK (ip_hash ~ '^[a-f0-9]{64}$')
);

CREATE INDEX IF NOT EXISTS homefin_family_enrollment_attempts_family_time_idx
    ON public.homefin_family_enrollment_attempts (family_id, attempted_at DESC);

CREATE INDEX IF NOT EXISTS homefin_family_enrollment_attempts_ip_time_idx
    ON public.homefin_family_enrollment_attempts (ip_hash, attempted_at DESC);

CREATE TABLE IF NOT EXISTS public.homefin_family_enrollment_audit (
    id bigint GENERATED ALWAYS AS IDENTITY PRIMARY KEY,
    family_id text NOT NULL,
    event_type text NOT NULL,
    actor_label text,
    verification_method text,
    ip_hash text,
    occurred_at timestamptz NOT NULL DEFAULT pg_catalog.now(),
    CONSTRAINT homefin_family_enrollment_audit_family_format
        CHECK (family_id ~ '^[a-z0-9][a-z0-9-]{0,99}$'),
    CONSTRAINT homefin_family_enrollment_audit_event_type
        CHECK (event_type IN (
            'authorization_issued',
            'authorization_denied',
            'authorization_consumed',
            'authorization_invalid',
            'authorization_expired',
            'authorization_reused',
            'credential_already_exists',
            'attempt_rate_limited'
        )),
    CONSTRAINT homefin_family_enrollment_audit_ip_hash_format
        CHECK (ip_hash IS NULL OR ip_hash ~ '^[a-f0-9]{64}$')
);

CREATE INDEX IF NOT EXISTS homefin_family_enrollment_audit_family_time_idx
    ON public.homefin_family_enrollment_audit (family_id, occurred_at DESC);

CREATE INDEX IF NOT EXISTS homefin_family_enrollment_audit_ip_time_idx
    ON public.homefin_family_enrollment_audit (ip_hash, occurred_at DESC)
    WHERE ip_hash IS NOT NULL;

ALTER TABLE public.homefin_family_enrollment_authorizations ENABLE ROW LEVEL SECURITY;
ALTER TABLE public.homefin_family_enrollment_attempts ENABLE ROW LEVEL SECURITY;
ALTER TABLE public.homefin_family_enrollment_audit ENABLE ROW LEVEL SECURITY;

REVOKE ALL ON public.homefin_family_enrollment_authorizations FROM PUBLIC, anon, authenticated;
REVOKE ALL ON public.homefin_family_enrollment_attempts FROM PUBLIC, anon, authenticated;
REVOKE ALL ON public.homefin_family_enrollment_audit FROM PUBLIC, anon, authenticated;
REVOKE ALL ON SEQUENCE public.homefin_family_enrollment_attempts_id_seq FROM PUBLIC, anon, authenticated;
REVOKE ALL ON SEQUENCE public.homefin_family_enrollment_audit_id_seq FROM PUBLIC, anon, authenticated;

GRANT SELECT, INSERT, UPDATE, DELETE
    ON public.homefin_family_enrollment_authorizations TO service_role;
GRANT SELECT, INSERT, UPDATE, DELETE
    ON public.homefin_family_enrollment_attempts TO service_role;
GRANT SELECT, INSERT, UPDATE, DELETE
    ON public.homefin_family_enrollment_audit TO service_role;
GRANT USAGE, SELECT
    ON SEQUENCE public.homefin_family_enrollment_attempts_id_seq TO service_role;
GRANT USAGE, SELECT
    ON SEQUENCE public.homefin_family_enrollment_audit_id_seq TO service_role;

CREATE OR REPLACE FUNCTION public.homefin_issue_family_enrollment_authorization(
    p_family_id text,
    p_authorization_hash text,
    p_expires_at timestamptz,
    p_verified_by text,
    p_verification_method text,
    p_ip_hash text
)
RETURNS jsonb
LANGUAGE plpgsql
SECURITY DEFINER
SET search_path = ''
AS $function$
DECLARE
    v_family_exists boolean;
BEGIN
    IF p_family_id IS NULL
       OR p_family_id !~ '^[a-z0-9][a-z0-9-]{0,99}$'
       OR p_authorization_hash IS NULL
       OR p_authorization_hash !~ '^[a-f0-9]{64}$'
       OR p_ip_hash IS NULL
       OR p_ip_hash !~ '^[a-f0-9]{64}$'
       OR p_expires_at IS NULL
       OR p_expires_at <= pg_catalog.now()
       OR p_expires_at > pg_catalog.now() + interval '15 minutes'
       OR p_verified_by IS NULL
       OR pg_catalog.char_length(pg_catalog.btrim(p_verified_by)) NOT BETWEEN 2 AND 80
       OR p_verification_method IS NULL
       OR p_verification_method NOT IN (
           'known_phone',
           'previously_verified_email',
           'in_person',
           'other_official_channel'
       ) THEN
        RETURN pg_catalog.jsonb_build_object('success', false, 'reason', 'invalid_request');
    END IF;

    PERFORM pg_catalog.pg_advisory_xact_lock(
        pg_catalog.hashtextextended('family-enrollment:' || p_family_id, 0)
    );

    SELECT EXISTS (
        SELECT 1
          FROM public.homefin_saas AS s
          CROSS JOIN LATERAL pg_catalog.jsonb_array_elements(
              CASE
                  WHEN pg_catalog.jsonb_typeof(s.data->'families') = 'array'
                      THEN s.data->'families'
                  ELSE '[]'::jsonb
              END
          ) AS family(value)
         WHERE s.id = 'global'
           AND family.value->>'id' = p_family_id
    )
      INTO v_family_exists;

    IF NOT v_family_exists THEN
        INSERT INTO public.homefin_family_enrollment_audit (
            family_id, event_type, actor_label, verification_method, ip_hash
        ) VALUES (
            p_family_id, 'authorization_denied', p_verified_by, p_verification_method, p_ip_hash
        );
        RETURN pg_catalog.jsonb_build_object('success', false, 'reason', 'family_not_found');
    END IF;

    IF EXISTS (
        SELECT 1
          FROM public.homefin_family_credentials AS c
         WHERE c.family_id = p_family_id
    ) THEN
        INSERT INTO public.homefin_family_enrollment_audit (
            family_id, event_type, actor_label, verification_method, ip_hash
        ) VALUES (
            p_family_id, 'credential_already_exists', p_verified_by, p_verification_method, p_ip_hash
        );
        RETURN pg_catalog.jsonb_build_object('success', false, 'reason', 'credential_exists');
    END IF;

    UPDATE public.homefin_family_enrollment_authorizations
       SET revoked_at = pg_catalog.now()
     WHERE family_id = p_family_id
       AND consumed_at IS NULL
       AND revoked_at IS NULL;

    INSERT INTO public.homefin_family_enrollment_authorizations (
        family_id,
        authorization_hash,
        verification_method,
        verified_by,
        expires_at
    ) VALUES (
        p_family_id,
        p_authorization_hash,
        p_verification_method,
        pg_catalog.btrim(p_verified_by),
        p_expires_at
    );

    INSERT INTO public.homefin_family_enrollment_audit (
        family_id, event_type, actor_label, verification_method, ip_hash
    ) VALUES (
        p_family_id, 'authorization_issued', pg_catalog.btrim(p_verified_by),
        p_verification_method, p_ip_hash
    );

    RETURN pg_catalog.jsonb_build_object(
        'success', true,
        'expiresAt', p_expires_at
    );
END;
$function$;

CREATE OR REPLACE FUNCTION public.homefin_register_family_enrollment_attempt(
    p_family_id text,
    p_ip_hash text
)
RETURNS jsonb
LANGUAGE plpgsql
SECURITY DEFINER
SET search_path = ''
AS $function$
DECLARE
    v_family_count integer;
    v_ip_count integer;
BEGIN
    IF p_family_id IS NULL
       OR p_family_id !~ '^[a-z0-9][a-z0-9-]{0,99}$'
       OR p_ip_hash IS NULL
       OR p_ip_hash !~ '^[a-f0-9]{64}$' THEN
        RETURN pg_catalog.jsonb_build_object('allowed', false, 'reason', 'invalid_request');
    END IF;

    PERFORM pg_catalog.pg_advisory_xact_lock(
        pg_catalog.hashtextextended('family-enrollment:' || p_family_id, 0)
    );
    PERFORM pg_catalog.pg_advisory_xact_lock(
        pg_catalog.hashtextextended('family-enrollment-ip:' || p_ip_hash, 0)
    );

    DELETE FROM public.homefin_family_enrollment_attempts
     WHERE attempted_at < pg_catalog.now() - interval '30 days';

    SELECT pg_catalog.count(*)::integer
      INTO v_family_count
      FROM public.homefin_family_enrollment_attempts
     WHERE family_id = p_family_id
       AND attempted_at >= pg_catalog.now() - interval '1 hour';

    SELECT pg_catalog.count(*)::integer
      INTO v_ip_count
      FROM public.homefin_family_enrollment_attempts
     WHERE ip_hash = p_ip_hash
       AND attempted_at >= pg_catalog.now() - interval '1 hour';

    IF v_family_count >= 5 OR v_ip_count >= 20 THEN
        IF NOT EXISTS (
            SELECT 1
              FROM public.homefin_family_enrollment_audit AS a
             WHERE a.family_id = p_family_id
               AND a.ip_hash = p_ip_hash
               AND a.event_type = 'attempt_rate_limited'
               AND a.occurred_at >= pg_catalog.now() - interval '1 hour'
        ) THEN
            INSERT INTO public.homefin_family_enrollment_audit (
                family_id, event_type, ip_hash
            ) VALUES (
                p_family_id, 'attempt_rate_limited', p_ip_hash
            );
        END IF;
        RETURN pg_catalog.jsonb_build_object('allowed', false, 'reason', 'rate_limited');
    END IF;

    INSERT INTO public.homefin_family_enrollment_attempts (family_id, ip_hash)
    VALUES (p_family_id, p_ip_hash);

    RETURN pg_catalog.jsonb_build_object('allowed', true);
END;
$function$;

CREATE OR REPLACE FUNCTION public.homefin_consume_family_enrollment_authorization(
    p_family_id text,
    p_authorization_hash text,
    p_pin_salt text,
    p_pin_hash text,
    p_ip_hash text
)
RETURNS jsonb
LANGUAGE plpgsql
SECURITY DEFINER
SET search_path = ''
AS $function$
DECLARE
    v_authorization public.homefin_family_enrollment_authorizations%ROWTYPE;
BEGIN
    IF p_family_id IS NULL
       OR p_family_id !~ '^[a-z0-9][a-z0-9-]{0,99}$'
       OR p_authorization_hash IS NULL
       OR p_authorization_hash !~ '^[a-f0-9]{64}$'
       OR p_pin_salt IS NULL
       OR p_pin_salt !~ '^[a-f0-9]{32}$'
       OR p_pin_hash IS NULL
       OR p_pin_hash !~ '^[a-f0-9]{128}$'
       OR p_ip_hash IS NULL
       OR p_ip_hash !~ '^[a-f0-9]{64}$' THEN
        RETURN pg_catalog.jsonb_build_object('success', false, 'reason', 'invalid_request');
    END IF;

    PERFORM pg_catalog.pg_advisory_xact_lock(
        pg_catalog.hashtextextended('family-enrollment:' || p_family_id, 0)
    );

    SELECT *
      INTO v_authorization
      FROM public.homefin_family_enrollment_authorizations AS a
     WHERE a.family_id = p_family_id
       AND a.authorization_hash = p_authorization_hash
     FOR UPDATE;

    IF NOT FOUND THEN
        INSERT INTO public.homefin_family_enrollment_audit (
            family_id, event_type, ip_hash
        ) VALUES (
            p_family_id, 'authorization_invalid', p_ip_hash
        );
        RETURN pg_catalog.jsonb_build_object('success', false, 'reason', 'invalid_authorization');
    END IF;

    IF v_authorization.consumed_at IS NOT NULL THEN
        INSERT INTO public.homefin_family_enrollment_audit (
            family_id, event_type, ip_hash
        ) VALUES (
            p_family_id, 'authorization_reused', p_ip_hash
        );
        RETURN pg_catalog.jsonb_build_object('success', false, 'reason', 'authorization_reused');
    END IF;

    IF v_authorization.revoked_at IS NOT NULL THEN
        INSERT INTO public.homefin_family_enrollment_audit (
            family_id, event_type, ip_hash
        ) VALUES (
            p_family_id, 'authorization_invalid', p_ip_hash
        );
        RETURN pg_catalog.jsonb_build_object('success', false, 'reason', 'invalid_authorization');
    END IF;

    IF v_authorization.expires_at <= pg_catalog.now() THEN
        INSERT INTO public.homefin_family_enrollment_audit (
            family_id, event_type, ip_hash
        ) VALUES (
            p_family_id, 'authorization_expired', p_ip_hash
        );
        RETURN pg_catalog.jsonb_build_object('success', false, 'reason', 'authorization_expired');
    END IF;

    IF EXISTS (
        SELECT 1
          FROM public.homefin_family_credentials AS c
         WHERE c.family_id = p_family_id
    ) THEN
        INSERT INTO public.homefin_family_enrollment_audit (
            family_id, event_type, ip_hash
        ) VALUES (
            p_family_id, 'credential_already_exists', p_ip_hash
        );
        RETURN pg_catalog.jsonb_build_object('success', false, 'reason', 'credential_exists');
    END IF;

    BEGIN
        UPDATE public.homefin_family_enrollment_authorizations
           SET consumed_at = pg_catalog.now()
         WHERE id = v_authorization.id
           AND consumed_at IS NULL
           AND revoked_at IS NULL
           AND expires_at > pg_catalog.now();

        IF NOT FOUND THEN
            RETURN pg_catalog.jsonb_build_object('success', false, 'reason', 'authorization_reused');
        END IF;

        INSERT INTO public.homefin_family_credentials (
            family_id,
            pin_salt,
            pin_hash,
            recovery_salt,
            recovery_hash,
            session_version,
            created_at,
            updated_at
        ) VALUES (
            p_family_id,
            p_pin_salt,
            p_pin_hash,
            NULL,
            NULL,
            1,
            pg_catalog.now(),
            pg_catalog.now()
        );
    EXCEPTION
        WHEN unique_violation THEN
            INSERT INTO public.homefin_family_enrollment_audit (
                family_id, event_type, ip_hash
            ) VALUES (
                p_family_id, 'credential_already_exists', p_ip_hash
            );
            RETURN pg_catalog.jsonb_build_object('success', false, 'reason', 'credential_exists');
    END;

    INSERT INTO public.homefin_family_enrollment_audit (
        family_id, event_type, actor_label, verification_method, ip_hash
    ) VALUES (
        p_family_id,
        'authorization_consumed',
        v_authorization.verified_by,
        v_authorization.verification_method,
        p_ip_hash
    );

    RETURN pg_catalog.jsonb_build_object('success', true, 'sessionVersion', 1);
END;
$function$;

REVOKE ALL ON FUNCTION public.homefin_issue_family_enrollment_authorization(
    text, text, timestamptz, text, text, text
) FROM PUBLIC, anon, authenticated;
REVOKE ALL ON FUNCTION public.homefin_register_family_enrollment_attempt(text, text)
    FROM PUBLIC, anon, authenticated;
REVOKE ALL ON FUNCTION public.homefin_consume_family_enrollment_authorization(
    text, text, text, text, text
) FROM PUBLIC, anon, authenticated;

GRANT EXECUTE ON FUNCTION public.homefin_issue_family_enrollment_authorization(
    text, text, timestamptz, text, text, text
) TO service_role;
GRANT EXECUTE ON FUNCTION public.homefin_register_family_enrollment_attempt(text, text)
    TO service_role;
GRANT EXECUTE ON FUNCTION public.homefin_consume_family_enrollment_authorization(
    text, text, text, text, text
) TO service_role;
